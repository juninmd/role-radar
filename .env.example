# ── AI Provider: litellm | ollama | openai | anthropic | google ──
AI_PROVIDER=litellm

# LiteLLM do cluster (padrão — barato/centralizado)
LITELLM_BASE_URL=http://litellm.ai.svc.cluster.local:4000/v1
LITELLM_API_KEY=
LITELLM_MODEL=cloud/gemma3

# Ollama local (fallback offline)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google Gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# ── Telegram (obtenha o chat id em @userinfobot) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=123456789

# ── Cron (UTC). Digest 8h BRT = 11h UTC ──
CRON_INGESTION=*/30 * * * *
CRON_DIGEST=0 11 * * *

# ── Config ──
DB_PATH=./data/store.db
MAX_ITEMS_PER_FEED=20
DIGEST_MAX_ITEMS=40
FEED_TIMEOUT_MS=12000
AI_TIMEOUT_MS=60000
GEOCODE_MAX=25
ARTICLE_MAX=40
# 1 = Google News via IPv6 do host (o IPv4 do cluster leva 429); exige hostNetwork
GOOGLE_IPV6=

# ── Dashboard web (bun run serve) ──
PORT=3000
